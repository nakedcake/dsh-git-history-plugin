{
  "name": "@local/dsh-plugin-git-history",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Git commit history and a per-commit viewer in the Harness Web right sidebar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./git": "./git.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "git.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
